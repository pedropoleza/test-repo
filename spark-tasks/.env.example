# Spark Tasks — required environment (validated at boot by src/env.ts).
# Copy to .env.local for local dev. All of these are also set in the Vercel
# project. NEVER commit real values. Tokens are encrypted at rest with
# ENCRYPTION_KEY and must never be logged.

# --- Database: existing Supabase project, schema spark_tasks ---
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres"
SUPABASE_SERVICE_ROLE_KEY="..."

# --- GHL agency app (OAuth + SSO) ---
GHL_APP_CLIENT_ID="..."
GHL_APP_CLIENT_SECRET="..."
# Agency "Shared Secret Key" that decrypts the iframe SSO payload.
GHL_SSO_KEY="..."
# Agency/company id — companyId in POST /oauth/locationToken.
GHL_COMPANY_ID="..."

# --- Crypto / sessions ---
# base64 of 32 random bytes:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY="..."
# >=32 chars for signing the httpOnly session cookie:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET="..."

# --- Background jobs (Trigger.dev; contact write-back on completion) ---
# Optional until the Trigger.dev project is provisioned; the write-back runs
# via Next after() with retries in the meantime.
TRIGGER_SECRET_KEY="..."
# Optional: tag added to the GHL contact when a linked task completes (D7).
GHL_WRITEBACK_TAG="tarefa-concluida"
